<?xml version='1.0' encoding='utf-8'?>

<widget 
    id="com.example.driveaware"
    android-packageName="com.example.driveaware"
    version="1.0.0" 
    xmlns="https://www.w3.org/ns/widgets"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <name>Motion Visual</name>

    <description>
        Visualizes the X, Y, and Z coordinates of a mobile device's motion sensor (accelerometer).
    </description>

    <author email="project@example.com" href="#">Drive Aware (public example)</author>

    <content src="index.html" />
    <icon src="resources/iconTemplate1.png" />

        <!-- =================================================================== -->
    <!-- General Preferences: configure defaults for your hybrid app         -->
    <!-- for example:                                                        -->
    <!-- Orientation: values: landscape, portrait, or default (allow both)   -->
    <!-- DisallowOverscroll: have the webview not "bounce" when touched      -->
    <!-- android-minSdkVersion:  set minimum threshhold of OS versions       -->
     <!--  SDK/API Level | version       | Codename        | Year             -->
    <!-- ===============+===============+=================+=====             -->
    <!--        33      | Android 13    | Tiramisu        | 2022             -->
    <!--        31/32   | Android 12    | Snow Cone       | 2021             -->
    <!--        30      | Android 11    | Red Velvet Cake | 2020             -->
    <!--        29      | Android 10    | Quice Tart      | 2019             -->
    <!--        28      | Android 9.0.0 | Pie             | 2018             -->
    <!--        27      | Android 8.1.0 | Oreo            | 2017             -->
    <!--        22      | Android 5.1.1 | Lillipop        | 2015             -->
       <!-- =================================================================== -->

    <engine name="android" spec="12.0.1" />

    <preference name="Orientation" value="portrait" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="android-minSdkVersion" value="22" />

    <!-- Motion sensor plugin -->
    <plugin name="cordova-plugin-device-motion" />

    <!-- Status bar plugin -->
    <plugin name="cordova-plugin-statusbar" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#FFC627" />
    <preference name="StatusBarStyle" value="lightcontent" />

    <!-- Splash screen preferences -->
    <preference name="SplashScreenDelay" value="2000" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/splashTemplate2.png" />
    <preference name="AndroidWindowSplashScreenBackground" value="#000000" />

    <!-- Access rules (used later for your Pi, Firebase, etc.) -->
    <access origin="*" />
    <access origin="http://*.googleapis.com" subdomains="true" />
    <access origin="http://*.gstatic.com" subdomains="true" />

    <!-- Intent rules -->
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <platform name="android">
        <allow-intent href="market:*" />
         <edit-config file="AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
    </platform>

    <!-- Optional iOS settings (won't affect Android build) -->
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />

        <edit-config target="NSMotionUsageDescription" file="*-Info.plist" mode="overwrite">
            <string>Allow the app to sense motion?</string>
        </edit-config>
        <edit-config target="NSLocationAlwaysUsageDescription" file="*-Info.plist" mode="overwrite">
            <string>Allow the app to know your location?</string>
        </edit-config>
        <edit-config target="NSLocationWhenInUseUsageDescription" file="*-Info.plist" mode="overwrite">
            <string>Allow the app to know your location?</string>
        </edit-config>
        <edit-config target="NSCameraUsageDescription" file="*-Info.plist" mode="overwrite">
            <string>Allow camera access to take a photo of a document.</string>
        </edit-config>
        <edit-config target="NSPhotoLibraryUsageDescription" file="*-Info.plist" mode="overwrite">
            <string>Allow the app to access your photo library to upload files.</string>
        </edit-config>
    </platform>

</widget>
